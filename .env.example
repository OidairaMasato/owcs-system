# ローカル実行用のテンプレート。実際の値を入れたファイルはコミットしないこと。
# Windows では下記を使わず、ユーザー環境変数に入れるのが楽:
#   [Environment]::SetEnvironmentVariable("PANDASCORE_TOKEN", "...", "User")

PANDASCORE_TOKEN=

# 本番（Neon）で使う。ローカルは application.yml の既定値（localhost:5433）で動く。
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
